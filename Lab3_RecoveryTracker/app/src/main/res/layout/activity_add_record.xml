<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="📝 Новая запись"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Уровень боли -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="😖 Уровень боли"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/tvPainLabel"
            android:text="0"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_red_dark"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <SeekBar
            android:id="@+id/seekBarPain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:layout_marginBottom="16dp"/>

        <!-- Уровень активности -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="💪 Уровень активности"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/tvActivityLabel"
            android:text="0%"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_green_dark"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <SeekBar
            android:id="@+id/seekBarActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:layout_marginBottom="16dp"/>

        <!-- Лекарства -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="💊 Принятые лекарства"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etMedications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="например: Ибупрофен 200мг"
            android:minLines="1"
            android:layout_marginBottom="16dp"/>

        <!-- Заметки -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="📝 Заметки"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Дополнительная информация..."
            android:minLines="3"
            android:layout_marginBottom="24dp"/>

        <!-- Кнопки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Отмена"
                android:backgroundTint="@android:color/darker_gray"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Сохранить"
                android:backgroundTint="@android:color/holo_blue_dark"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>